{
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(orca skills get orchestration *)",
      "Bash(orca orchestration run-create *)",
      "Bash(orca orchestration run-current *)",
      "Bash(orca orchestration run-use *)",
      "Bash(orca orchestration run-show *)",
      "Bash(orca orchestration task-create *)",
      "Bash(orca orchestration task-list *)",
      "Bash(orca orchestration worker-start *)",
      "Bash(orca orchestration worker-show *)",
      "Bash(orca orchestration worker-list *)",
      "Bash(orca orchestration worker-release *)",
      "Bash(orca orchestration send *)",
      "Bash(orca orchestration check *)",
      "Bash(orca orchestration reply *)",
      "Bash(orca orchestration ask *)",
      "Bash(orca orchestration inbox *)",
      "Bash(orca orchestration gate-create *)",
      "Bash(orca orchestration gate-list *)",
      "Bash(git add -- *)",
      "Bash(git commit -m *)",
      "Bash(git cherry-pick *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npx create-expo-app *)",
      "Bash(npm ci)",
      "Bash(orca orchestration task-update *)",
      "Bash(orca orchestration worker-read *)",
      "Bash(orca orchestration request-show *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch origin main)",
      "Bash(git push origin *:refs/heads/orca/*)",
      "Bash(gh pr create --repo Joyanggi/TB --base main --head orca/*)",
      "Bash(gh pr edit * --repo Joyanggi/TB --body-file *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(/opt/homebrew/bin/tb-orca-merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.codex/auth.json)",
      "Read(~/.ssh/**)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Bash(git * --no-index*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git * --textconv*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit --amen*)",
      "Bash(git commit * --amen*)",
      "Bash(git commit --no-verif*)",
      "Bash(git commit * --no-verif*)",
      "Read(**/*.pem)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Bash(git diff /*)",
      "Bash(git diff * /*)",
      "Bash(git diff ~*)",
      "Bash(git diff * ~*)",
      "Bash(git diff ../*)",
      "Bash(git diff * ../*)",
      "Read(**/*.key)",
      "Read(~/.gnupg/**)",
      "Read(~/.git-credentials)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(REVIEW.md)",
      "Write(REVIEW.md)"
    ]
  },
  "effortLevel": "high"
}
