      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)"
